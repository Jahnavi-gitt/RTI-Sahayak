# Never commit a real .env file — this is a template only.

# OpenAI API key. Keep this on the server ONLY. Never expose it in
# frontend code, git history, or client-visible responses. If this is
# unset or the API call fails for any reason, every endpoint below
# falls back to a deterministic mock response so the app stays usable.
OPENAI_API_KEY=

# Model to use for structured JSON generation.
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of allowed CORS origins (your deployed frontend URL(s)).
CORS_ORIGINS=http://localhost:5173

# Basic per-IP rate limit for the AI endpoints, e.g. "20/minute".
AI_RATE_LIMIT=20/minute
